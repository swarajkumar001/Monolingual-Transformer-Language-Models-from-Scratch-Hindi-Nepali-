# Python environment
.venv/
__pycache__/
*.pyc

# Claude Code session state (not project content)
.claude/

# Download logs (tqdm progress-bar noise, not useful history)
*.log

# Model checkpoints (Phase 2+, will be large binary files)
checkpoints/

# Merged flat-text corpus SentencePiece trains on - a multi-hundred-MB
# intermediate regenerated by train_tokenizer.py's build_merged_corpus(),
# not a deliverable itself (the .model/.vocab files are). Same "no raw text
# blobs in git" reasoning as the data/ excludes above.
*/tokenizer/_train_corpus.txt

# Runtime single-instance lock files (acquire_single_instance_lock) -
# process-local, PID-tagged, meaningless outside the run that created them.
.clean.lock
.split.lock
.train.lock

# Corpus data - NOT committed to git (hundreds of thousands of files, many
# hundred million characters). Per the course spec, raw and cleaned data goes
# to Google Drive instead, not GitHub. Only the pipeline code that produces
# this data is tracked.
hindi/data/raw/
hindi/data/interim/
hindi/data/cleaned/
hindi/data/processed/
hindi/data/splits/
hindi/data/metadata/*
hindi/data/external/
bhojpuri/data/raw/
bhojpuri/data/interim/
bhojpuri/data/cleaned/
bhojpuri/data/processed/
bhojpuri/data/splits/
bhojpuri/data/metadata/*
bhojpuri/data/external/

# Small summary statistics ARE worth versioning even though the rest of
# data/metadata/ is ignored above (negation only works when the parent dir
# itself isn't excluded, hence the /* above rather than a bare directory
# ignore).
!hindi/data/metadata/clean_stats.json
!bhojpuri/data/metadata/clean_stats.json
*/tokenizer/_train_corpus.txt
*/tokenizer/_train_corpus.txt

# fastText lid.176 language-ID model (131MB), downloaded on demand by
# nepali/scripts/corpuslib/langid.py - not a deliverable, not reproducible
# content, just a third-party binary the pipeline fetches itself if absent.
lid.176.bin
