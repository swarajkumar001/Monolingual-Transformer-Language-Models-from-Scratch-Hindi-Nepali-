# Python environment
.venv/
__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store

# Local editor/session state (not project content)
.claude/

# Download logs (tqdm progress-bar noise, not useful history)
*.log

# Model checkpoints (Phase 2+, will be large binary files)
checkpoints/

# Merged flat-text corpus SentencePiece trains on - a multi-hundred-MB
# intermediate regenerated by train_tokenizer.py's build_merged_corpus(),
# not a deliverable itself (the .model/.vocab files are). Same "no raw text
# blobs in git" reasoning as the data/ excludes above.
*/tokenizer/_train_corpus.txt

# Runtime single-instance lock files (acquire_single_instance_lock) -
# process-local, PID-tagged, meaningless outside the run that created them.
.clean.lock
.split.lock
.train.lock

# Corpus data - NOT committed to git (hundreds of thousands of files, many
# hundred million characters). Per the course spec, raw and cleaned data goes
# to Google Drive instead, not GitHub. Only the pipeline code that produces
# this data is tracked.
hindi/data/raw/
hindi/data/interim/
hindi/data/cleaned/
hindi/data/processed/
hindi/data/splits/
hindi/data/metadata/*
hindi/data/external/
bhojpuri/data/raw/
bhojpuri/data/interim/
bhojpuri/data/cleaned/
bhojpuri/data/processed/
bhojpuri/data/splits/
bhojpuri/data/metadata/*
bhojpuri/data/external/

# Small summary statistics ARE worth versioning even though the rest of
# data/metadata/ is ignored above (negation only works when the parent dir
# itself isn't excluded, hence the /* above rather than a bare directory
# ignore).
!hindi/data/metadata/clean_stats.json
!bhojpuri/data/metadata/clean_stats.json
*/tokenizer/_train_corpus.txt
*/tokenizer/_train_corpus.txt

# fastText lid.176 language-ID model (131MB), downloaded on demand by
# nepali/scripts/corpuslib/langid.py - not a deliverable, not reproducible
# content, just a third-party binary the pipeline fetches itself if absent.
lid.176.bin

# Nepali corpus data. Same "code only, corpus data goes elsewhere" convention as
# hindi above - nepali/data/ alone is ~20GB. Enumerated by subdirectory rather
# than ignoring nepali/data/ wholesale, because that directory also holds Model
# L's own dataset code (dataset.py, pack_corpus.py), which IS a deliverable.
nepali/data/raw/
nepali/data/interim/
nepali/data/final/
nepali/data/*.json

# Phase 2 packed token streams (uint16 memmaps produced by scripts/pack_corpus.py).
# ~1GB per language and fully regenerable from the Phase 1 splits + tokenizer,
# so they follow the same "code in git, corpus data elsewhere" rule as the
# splits themselves. The small .json sidecars ARE tracked - they record the
# exact token counts the report cites.
hindi/data/packed/*.bin
nepali/data/packed/*.bin

# ...but the packed sidecars and every .py file under data/ ARE tracked: the
# sidecars record the exact token counts the Phase 2 report cites, and the
# dataset/packing code is a graded deliverable.
!hindi/data/packed/*.json
!nepali/data/packed/*.json

# Local zip of the Hindi corpus, staged for upload to external hosting. 6GB of
# already-gitignored data in a single file - the spec is explicit that large
# binary artifacts do not go in git.
hindi/data.zip

# Kaggle kernel downloads. These are transport, not deliverables: the small
# artifacts are copied into report/ by hand and the checkpoint archives are
# over a gigabyte and belong on Drive.
kaggle_output/
